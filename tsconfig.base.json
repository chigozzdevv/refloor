{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@refloor/scene": ["./packages/scene/src/index.ts"],
      "@refloor/scene/*": ["./packages/scene/src/*.ts"],
      "@scene-test/*": ["./packages/scene/test/*.ts"],
      "@refloor/engine": ["./packages/engine/src/index.ts"],
      "@refloor/engine/*": ["./packages/engine/src/*.ts"],
      "@engine-test/*": ["./packages/engine/test/*.ts"]
    }
  }
}
