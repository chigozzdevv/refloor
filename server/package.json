{
  "name": "@refloor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "db:dev": "node --env-file-if-exists=../.env --import tsx scripts/database.ts",
    "browser:fixtures": "node --import tsx scripts/browser-fixtures.ts",
    "browser:serve": "node --import tsx scripts/browser-server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@refloor/catalogue": "workspace:*",
    "@refloor/engine": "workspace:*",
    "@refloor/scene": "workspace:*",
    "fastify": "5.12.7",
    "mongodb": "7.7.0",
    "openai": "7.38.0",
    "socket.io": "4.8.4",
    "z3-solver": "5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
