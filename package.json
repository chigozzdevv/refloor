{
  "name": "refloor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @refloor/client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "lint": "eslint packages client server scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && pnpm --filter @refloor/server browser:fixtures && playwright test --config client/test/browser/playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm check:assets && pnpm build && pnpm check:bundles && pnpm -r --if-present typecheck && vitest run",
    "check:assets": "tsc -p scripts/tsconfig.json && node scripts/check-assets.ts",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "preview": "pnpm --filter @refloor/client preview",
    "dev:server": "pnpm build:packages && pnpm --filter @refloor/server dev",
    "db:dev": "pnpm --filter @refloor/server db:dev",
    "check:bundles": "tsc -p scripts/tsconfig.json && node scripts/check-client-bundle.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
