{
  "name": "refloor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @refloor/client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "lint": "eslint packages client --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm -r --if-present typecheck && vitest run",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "preview": "pnpm --filter @refloor/client preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
