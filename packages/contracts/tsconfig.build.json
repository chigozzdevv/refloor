{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@refloor/contracts": ["./src/index.ts"],
      "@refloor/contracts/*": ["./src/*.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["test"]
}
